{{- /*
  사이트맵 — 태그 페이지 제외 (2026-08-03)

  배경:
    기본 사이트맵 322개 중 태그가 216개(67%)였고 실제 글은 96개뿐이었다.
    태그는 대부분 제목에서 기계적으로 잘려 나온 것("완벽", "방법", "필요할까")
    이라 글 한두 편만 걸린 껍데기다. 구글 크롤링 예산이 여기로 새면서
    새 글이 '발견됨 - 색인 안 됨' 상태로 몇 주씩 대기했다.

  카테고리(7개)는 메뉴에 노출되는 실제 탐색 경로이므로 남긴다.
  태그 페이지 자체는 내부 링크용으로 유지하되 noindex 를 준다
  (layouts/partials/extend_head.html 참고).

    /search/ 도 뺀다 (2026-09-07).
      robots.txt 가 Disallow: /search/ 로 막는데 사이트맵에는 실려 있었다.
      색인하지 말라면서 색인하라고 제출한 셈이라 GSC 가 '사이트맵에 포함된
      페이지가 robots.txt 에 의해 차단됨' 으로 경고를 보냈다(8/17 알림).
      프런트매터의 sitemap.disable 은 이 커스텀 템플릿에서 무시되므로
      여기서 직접 걸러야 한다.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- range .Pages }}
{{- if and (not (hasPrefix .RelPermalink "/tags/")) (not (hasPrefix .RelPermalink "/search/")) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    {{- end }}
  </url>
{{- end }}
{{- end }}
</urlset>
